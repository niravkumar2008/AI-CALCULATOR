# Copy to .env (git-ignored) on the SERVER and fill in. Never put a real key in git or in the calculator.
ANTHROPIC_API_KEY=
PUBLIC_URL=https://calc-proxy.example.com
MAIN_MODEL=claude-sonnet-5-5
# main = always the main model; haiku-first = try claude-haiku-4-5-20251001 first, main model if unsure
ROUTING=main
HAIKU_MODEL=claude-haiku-4-5-20251001
HAIKU_MIN_CONFIDENCE=0.85
REFUSAL_FALLBACK=1
MONTHLY_CAP=500
TRIAL_DAYS=30
# Free tier switch: N free AI solves per day without a subscription (0 = off)
FREE_DAILY=0
FREE_DAILY_UNLINKED=0
# Over-the-air firmware images (admin.py firmware ...). Default: ./firmware next to app.py
FIRMWARE_DIR=
BILLING_SECRET=
ADMIN_TOKEN=
