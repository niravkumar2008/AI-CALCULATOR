# Copy to .env (git-ignored) on the SERVER, or set these in the host's dashboard.
# Never put a real key in git or in the calculator.
ANTHROPIC_API_KEY=
PUBLIC_URL=https://calc-proxy.example.com

# Models: base tier = Sonnet 5.5 (default for the $15 plan), pro tier = Opus 5.5.
BASE_MODEL=claude-sonnet-5-5
PRO_MODEL=claude-opus-5-5
# 1 = on 429/5xx/529 overloaded, try the other model once before "busy"
MODEL_FALLBACK=1
CLAUDE_MAX_RETRIES=1
PROMPT_CACHE=1
REFUSAL_FALLBACK=1
# main = always the tier's model; haiku-first = try claude-haiku-4-5 first, main model if unsure
ROUTING=main
HAIKU_MODEL=claude-haiku-4-5
HAIKU_MIN_CONFIDENCE=0.85
# server = the proxy's prompts/solver_v1.txt + schema; device = the calculator's (bench tests only)
PROMPT_SOURCE=server
SYSTEM_PROMPT_FILE=
SCHEMA_FILE=

# Fair use per tier, trial, grace
MONTHLY_CAP=500
PRO_MONTHLY_CAP=280
TRIAL_DAYS=30
PAST_DUE_GRACE_DAYS=3
# Free tier switch: N free AI solves per day without a subscription (0 = off)
FREE_DAILY=0
FREE_DAILY_UNLINKED=0

# Per-calculator burst limits
SOLVE_CONCURRENCY=1
SOLVES_PER_MINUTE=4
SOLVES_PER_HOUR=40
OTHER_PER_MINUTE=30
LINK_PER_MINUTE_PER_IP=10
KEEPALIVE_SECONDS=15

# Linking: e-mailed confirmation link (signed with LINK_SECRET: 32+ random characters)
LINK_MODE=email
LINK_SECRET=
LINK_CONFIRM_MINUTES=30
PAIR_CODE_MINUTES=15
MAIL_BACKEND=smtp
MAIL_FROM=AI Calculator <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Billing: Stripe webhook signing secret (whsec_...) and which prices mean the pro tier
STRIPE_WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_S=300
PRO_PRICE_KEYS=pro,calc_pro_monthly

# Admin HTTP API (empty = off; use admin.py in the host's shell instead)
ADMIN_TOKEN=
# Over-the-air firmware images (admin.py firmware ...). Default: ./firmware next to app.py
FIRMWARE_DIR=
LOG_LEVEL=INFO
